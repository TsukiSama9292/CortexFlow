# ─── LLM 設定（必要，Stage 4 分析用） ───
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ─── LLM Proxy（選用，若使用 OpenAI 相容 API 代理） ───
OPENAI_BASE_URL=

# ─── Reddit API（選用，不設也可用 Demo 模式） ───
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ─── GitHub Token（選用，不設也可用 Trending 爬蟲） ───
GITHUB_TOKEN=

# ─── Pipeline 設定 ───
RELEVANCE_THRESHOLD=5
MAX_RESULTS_PER_SOURCE=20
REQUEST_TIMEOUT=30
